# Copy this file to `.env` and fill in your key for local development.
# In production (Vercel), set this in Project → Settings → Environment Variables.
#
# OpenRouter API key — used server-side only by /api/whatsapp-ai/chat.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: pin a specific OpenRouter model slug (e.g. "meta-llama/llama-3.3-70b-instruct:free").
# If unset, the app uses the "openrouter/free" auto-router.
OPENROUTER_MODEL=

# (Legacy) Google Gemini key — no longer used by the chat, kept for reference.
GEMINI_API_KEY=
