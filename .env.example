# ─────────────────────────────────────────────────────────────
# Portfolio Control Center — environment variables
# Copy to `.env` (gitignored) and fill in. All are optional in dev:
# if DB vars are missing the admin panel runs in a degraded "DB not
# configured" mode instead of crashing.
# ─────────────────────────────────────────────────────────────

# Turso / libSQL database (https://turso.tech)
# Leave blank in local dev to use an in-memory/file fallback.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin login. Change these before deploying.
# The password is never stored anywhere except this env var.
ADMIN_USERNAME=harish
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used to sign the session cookie (HMAC). Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=dev-only-insecure-secret-change-me

# Session lifetime in hours (default 12)
ADMIN_SESSION_HOURS=12
